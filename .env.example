# Copy this file to `.env` and fill in the key - docker-compose injects it
# into the sim container automatically.
#
#   cp .env.example .env
#
# Required. Workspace-scoped Anthropic key with credits:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Only needed if the key is org-level instead of workspace-scoped.
ANTHROPIC_WORKSPACE_ID=

# Planner model - the default is fine.
NL_ROBOT_MODEL=claude-opus-5
