<?xml version="1.0"?>
<robot name="robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Overall forklift scale (meshes, wheels, nose). Gripper Z stays at box height. -->
  <xacro:property name="S" value="1.35"/>
  <xacro:property name="WR" value="${0.4175 * S}"/>

   <link name="body">
    <inertial>
      <!-- Heavy enough not to yeet; light enough to accelerate -->
      <mass value="90"/>
      <inertia ixx="35" ixy="0" ixz="0" iyy="70" iyz="0" izz="80" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find TeleARM)/meshes/body.STL" scale="${S} ${S} ${S}"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/> <!-- Black color -->
      </material>
    </visual>
  </link>

  <link name="window">
    <inertial>
      <mass value="1"/>
      <inertia ixx=".1" ixy="0" ixz="0" iyy=".1" iyz="0" izz=".1" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find TeleARM)/meshes/window.STL" scale="${S} ${S} ${S}"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/> <!-- Black color -->
      </material>
    </visual>
  </link>
  <!-- Front Left -->
  <link name="front_left_wheel">
    <inertial>
      <mass value="10"/>
      <inertia ixx="0.6" ixy="0" ixz="0" iyy="0.6" iyz="0" izz="1.0" />
    </inertial>
    <collision>
      <origin xyz="0 0 ${0.16 * S}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${WR}" length="${0.16 * S}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find TeleARM)/meshes/wheel.STL" scale="${S} ${S} ${S}"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/> <!-- Black color -->
      </material>
    </visual>
  </link>
  <!-- Front Right -->
  <link name="front_right_wheel">
    <inertial>
      <mass value="10"/>
      <inertia ixx="0.6" ixy="0" ixz="0" iyy="0.6" iyz="0" izz="1.0" />
    </inertial>
    <collision>
      <origin xyz="0 0 ${0.16 * S}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${WR}" length="${0.16 * S}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find TeleARM)/meshes/wheel.STL" scale="${S} ${S} ${S}"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/> <!-- Black color -->
      </material>
    </visual>
  </link>
  <!-- Back Left -->
  <link name="back_left_wheel">
    <inertial>
      <mass value="10"/>
      <inertia ixx="0.6" ixy="0" ixz="0" iyy="0.6" iyz="0" izz="1.0" />
    </inertial>
    <collision>
      <origin xyz="0 0 ${0.16 * S}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${WR}" length="${0.16 * S}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find TeleARM)/meshes/wheel.STL" scale="${S} ${S} ${S}"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/> <!-- Black color -->
      </material>
    </visual>
  </link>
  <!-- Back Right -->
  <link name="back_right_wheel">
    <inertial>
      <mass value="10"/>
      <inertia ixx="0.6" ixy="0" ixz="0" iyy="0.6" iyz="0" izz="1.0" />
    </inertial>
    <collision>
      <origin xyz="0 0 ${0.16 * S}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${WR}" length="${0.16 * S}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find TeleARM)/meshes/wheel.STL" scale="${S} ${S} ${S}"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/> <!-- Black color -->
      </material>
    </visual>
  </link>
  <!-- Chunkier claw — open/close travel is obvious -->
  <link name="gripper_base">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.7 1.8 0.08"/>
      </geometry>
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
    <!-- no collision on base — only fingers touch boxes (avoids yeeting them) -->
  </link>

  <link name="left_finger">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0.45 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.4 0.14 0.40"/>
      </geometry>
      <material name="yellow">
        <color rgba="1 0.85 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.45 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.4 0.14 0.40"/>
      </geometry>
    </collision>
  </link>

  <link name="right_finger">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0.45 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.4 0.14 0.40"/>
      </geometry>
      <material name="yellow">
        <color rgba="1 0.85 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.45 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.4 0.14 0.40"/>
      </geometry>
    </collision>
  </link>

  <joint name="body_to_window" type="fixed">
    <origin xyz="0 0 0"/>
    <parent link="body"/>
    <child link="window"/>
  </joint>

  <joint name="body_to_front_left_wheel" type="continuous">
    <origin xyz="${1.505428 * S} ${0.573211 * S} ${0.055848 * S}" rpy="${-pi/2} 0 0"/>
    <parent link="body"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="body_to_front_right_wheel" type="continuous">
    <origin xyz="${1.505428 * S} ${-0.573211 * S} ${0.055848 * S}" rpy="${pi/2} 0 0"/>
    <parent link="body"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <joint name="body_to_back_left_wheel" type="continuous">
    <origin xyz="${-1.505428 * S} ${0.573211 * S} ${0.055848 * S}" rpy="${-pi/2} 0 0"/>
    <parent link="body"/>
    <child link="back_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="body_to_back_right_wheel" type="continuous">
    <origin xyz="${-1.505428 * S} ${-0.573211 * S} ${0.055848 * S}" rpy="${pi/2} 0 0"/>
    <parent link="body"/>
    <child link="back_right_wheel"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- Nose farther out (scaled); Z matches ~0.90 m box centers -->
  <joint name="body_to_gripper_base" type="fixed">
    <origin xyz="${2.35 * S} 0 0.45" rpy="0 0 0"/>
    <parent link="body"/>
    <child link="gripper_base"/>
  </joint>

  <joint name="gripper_left" type="prismatic">
    <origin xyz="0 0.16 0" rpy="0 0 0"/>
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <axis xyz="0 1 0"/>
    <!-- wide open vs tight close so claw motion is obvious -->
    <limit effort="120" velocity="0.5" lower="0.0" upper="0.80"/>
  </joint>

  <joint name="gripper_right" type="prismatic">
    <origin xyz="0 -0.16 0" rpy="0 0 0"/>
    <parent link="gripper_base"/>
    <child link="right_finger"/>
    <axis xyz="0 -1 0"/>
    <limit effort="120" velocity="0.5" lower="0.0" upper="0.80"/>
  </joint>

  

  <link name="camera_link"/>
  <joint name="body_to_camera_link" type="fixed">
    <origin xyz="${2.15 * S} 0 0.55" rpy="0 -0.55 0"/>
    <parent link="body"/>
    <child link="camera_link"/>
  </joint>

  <!-- Keep a lidar for /scan (avoidance). Camera is Image-only. -->
  <link name="lidar_link"/>
  <joint name="body_to_lidar_link" type="fixed">
    <origin xyz="${2.1 * S} 0 ${0.7 * S}" rpy="0 0 0"/>
    <parent link="body"/>
    <child link="lidar_link"/>
  </joint>



  

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="body_to_back_left_wheel">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="body_to_back_right_wheel">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_left">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.80</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_right">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.80</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <!-- Joint state publisher -->
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find TeleARM)/config/diff_drive_controller.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="body">
    <material>Gazebo/Red</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="window">
    <material>Gazebo/Black</material>
  </gazebo>
  <!-- Front wheels are undriven — zero friction so they don't drag the car -->
  <gazebo reference="front_left_wheel">
    <material>Gazebo/Black</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <material>Gazebo/Black</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="back_left_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
  </gazebo>
  <gazebo reference="back_right_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
  </gazebo>

  <!-- Grip friction — keep kp moderate so boxes don't get yeeted -->
  <gazebo reference="left_finger">
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>1e4</kp>
    <kd>10.0</kd>
  </gazebo>
  <gazebo reference="right_finger">
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>1e4</kp>
    <kd>10.0</kd>
  </gazebo>

  <gazebo reference="camera_link">
    <!-- RGB camera: publishes Image, NOT LaserScan.
         Note: may crash Gazebo Classic on WSL (needs graphics Scene). -->
    <sensor type="camera" name="rgb_camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>20.0</far>
        </clip>
      </camera>
      <plugin name="rgb_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>rgb_camera/image_raw:=/camera/image_raw</remapping>
          <remapping>rgb_camera/camera_info:=/camera/camera_info</remapping>
        </ros>
        <camera_name>rgb_camera</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="lidar" filename="libgazebo_ros_ray_sensor.so">
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

</robot>
